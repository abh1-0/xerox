# Customer/admin applications (public build-time values)
VITE_API_BASE_URL=http://localhost:8787
VITE_DEFAULT_SHOP_SLUG=abh1-demo

# API runtime
PORT=8787
SPRINT_WEB_ORIGIN=http://localhost:5173
SPRINT_DATA_DIR=.sprint-data
SPRINT_STORAGE_DIR=.sprint-data/objects
SPRINT_UPLOAD_MAX_BYTES=20971520
SPRINT_DEVELOPMENT_PAYMENTS=true
# Development only. Generate a unique value before running a local merchant setup.
SPRINT_DEVELOPMENT_SETUP_KEY=replace-this-development-setup-key
# Required to use the restricted admin surface.
SPRINT_ADMIN_TOKEN=replace-with-a-long-random-admin-token
