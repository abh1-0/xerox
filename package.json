{
  "name": "sprint-by-abh1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/customer-web",
    "apps/admin-web",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace=@sprint/api",
    "dev:customer": "npm run dev --workspace=@sprint/customer-web",
    "dev:admin": "npm run dev --workspace=@sprint/admin-web",
    "build": "npm run build --workspace=@sprint/customer-web && npm run build --workspace=@sprint/admin-web && dotnet build apps/merchant-windows/Sprint.Merchant/Sprint.Merchant.csproj",
    "test": "node --test packages/contracts/test/*.test.mjs apps/api/test/*.test.mjs",
    "db:migrate": "npm run migrate --workspace=@sprint/api",
    "db:seed": "npm run seed --workspace=@sprint/api",
    "worker:cleanup": "npm run cleanup --workspace=@sprint/api"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
