{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --workspace=@sprint/customer-web",
  "outputDirectory": "apps/customer-web/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://wbmbrnurizsujlbzaptl.supabase.co/functions/v1/sprint-api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
