<Window x:Class="Sprint.Merchant.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sprint Merchant" Height="760" Width="1180" MinHeight="600" MinWidth="900" Background="#F6F7F5">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#102238" Padding="22"><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Top"><TextBlock Text="sprint" Foreground="White" FontSize="28" FontWeight="Bold"/><TextBlock Text="by abh1 · merchant" Foreground="#AFC1D2" FontSize="12" Margin="1,1,0,36"/><Button Style="{StaticResource NavButton}" Content="Requests" IsDefault="True"/><Button Style="{StaticResource NavButton}" Content="Active"/><Button Style="{StaticResource NavButton}" Content="Completed"/><Button Style="{StaticResource NavButton}" Content="Printers" Click="Printers_Click"/><Button Style="{StaticResource NavButton}" Content="Services"/><Button Style="{StaticResource NavButton}" Content="Transactions"/><Button Style="{StaticResource NavButton}" Content="Settings" Click="Settings_Click"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><Border Background="#193D52" Padding="10" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="ConnectionText" Text="Connecting…" Foreground="White" FontWeight="SemiBold"/><TextBlock x:Name="DeviceText" Text="Device not registered" Foreground="#B8CED8" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border><Button Content="Pause requests" Style="{StaticResource SecondaryButton}"/></StackPanel></DockPanel></Border>
    <Grid Grid.Column="1" Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
      <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Stretch"><StackPanel Width="600"><TextBlock Text="Incoming requests" FontSize="30" FontWeight="Bold" Foreground="#17212B"/><TextBlock Text="Review exactly what the customer sent before printing." Foreground="#596870" Margin="0,5,0,24"/></StackPanel><Button Content="Refresh" Style="{StaticResource PrimaryButton}" Click="Refresh_Click"/></StackPanel>
      <Border Grid.Row="1" BorderBrush="#C8CFCD" BorderThickness="1,1,0,1" Background="White"><ListView x:Name="RequestList" SelectionChanged="RequestList_SelectionChanged" BorderThickness="0"><ListView.ItemTemplate><DataTemplate><Grid Margin="13,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding RequestNumber}" FontWeight="Bold" Foreground="#0E4FC9"/><TextBlock Text="{Binding Type}" FontSize="11" Foreground="#60727D"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayDetail}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StateLabel}" FontSize="12" Foreground="#60727D" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Amount}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border>
      <Border Grid.Column="1" Grid.Row="1" Background="#EAF0F5" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="DetailNumber" Text="Select a request" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="DetailType" Text="" Foreground="#52646E" Margin="0,4,0,18"/><TextBlock x:Name="DetailBody" Text="Select an incoming request to inspect its safe metadata and take an action." TextWrapping="Wrap" Foreground="#344651"/><Separator Margin="0,22,0,18"/><TextBlock Text="Physical printer" FontWeight="SemiBold"/><ComboBox x:Name="PrinterSelector" Height="36" Margin="0,7,0,16"/><Button x:Name="AcceptButton" Content="Accept" Style="{StaticResource SecondaryButton}" Click="Accept_Click" IsEnabled="False"/><Button x:Name="PrintButton" Content="Print" Style="{StaticResource PrimaryButton}" Click="Print_Click" IsEnabled="False" Margin="0,10,0,0"/><Button x:Name="CompleteButton" Content="Mark completed" Style="{StaticResource SecondaryButton}" Click="Complete_Click" IsEnabled="False" Margin="0,10,0,0"/><TextBlock x:Name="ActionMessage" Text="" TextWrapping="Wrap" Foreground="#9E281E" Margin="0,16,0,0"/></StackPanel></ScrollViewer></Border>
      <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="#C8CFCD" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,20,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="Sprint Cloud" FontWeight="SemiBold"/><TextBlock x:Name="CloudStatus" Text=" Connected" Foreground="#176040" Margin="6,0,28,0"/><TextBlock Text="Local queue" FontWeight="SemiBold"/><TextBlock x:Name="QueueStatus" Text=" 0" Foreground="#52646E" Margin="6,0,28,0"/><TextBlock Text="Printer service" FontWeight="SemiBold"/><TextBlock Text=" Running" Foreground="#176040" Margin="6,0,0,0"/></StackPanel></Border>
    </Grid>
  </Grid>
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button"><Setter Property="Foreground" Value="#C7D6E3"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,0,0,2"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1B3B56"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
    <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#0E4FC9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="15,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
    <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="Foreground" Value="#20333F"/><Setter Property="Background" Value="#F8FAF9"/><Setter Property="BorderBrush" Value="#93A2A5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Resources>
</Window>
